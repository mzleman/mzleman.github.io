---
import readBear from '../assets/ice-bear-read.png';
import sleepBear from '../assets/ice-bear-sleep.png';
---

<button class="ice-bear-btn" type="button" aria-pressed="false" aria-label="小熊在看书，点击切换为深色">
	<span class="ice-bear" style={`aspect-ratio: ${readBear.width} / ${readBear.height}`}>
		<img
			class="ice-bear__scene ice-bear__scene--read"
			src={readBear.src}
			width={readBear.width}
			height={readBear.height}
			alt=""
		/>
		<img
			class="ice-bear__scene ice-bear__scene--sleep"
			src={sleepBear.src}
			width={sleepBear.width}
			height={sleepBear.height}
			alt=""
		/>
	</span>
</button>

<style>
	.ice-bear-btn {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.ice-bear-btn:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 3px;
		border-radius: 16px;
	}

	.ice-bear {
		position: relative;
		display: block;
		width: 100%;
	}

	.ice-bear__scene {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center bottom;
		transition: opacity 0.28s ease;
	}

	.ice-bear__scene--sleep {
		opacity: 0;
	}

	:global(html[data-theme='dark']) .ice-bear__scene--read {
		opacity: 0;
	}

	:global(html[data-theme='dark']) .ice-bear__scene--sleep {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.ice-bear__scene {
			transition: none;
		}
	}
</style>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.ice-bear-btn');

	function currentTheme() {
		return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
	}

	function syncBear(button: HTMLButtonElement) {
		const dark = currentTheme() === 'dark';
		button.setAttribute('aria-pressed', dark ? 'true' : 'false');
		button.setAttribute('aria-label', dark ? '小熊在睡觉，点击切换为浅色' : '小熊在看书，点击切换为深色');
	}

	for (const button of buttons) {
		syncBear(button);
		button.addEventListener('click', () => {
			const next = currentTheme() === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			localStorage.setItem('theme', next);
			syncBear(button);
		});
	}
</script>
