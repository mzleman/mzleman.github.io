<style>
	.ice-bear {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.ice-bear__figure {
		transform-origin: 100px 210px;
		animation: ice-bear-bob 3.2s ease-in-out infinite;
	}

	.ice-bear__shadow {
		transform-origin: 100px 222px;
		animation: ice-bear-shadow 3.2s ease-in-out infinite;
	}

	.ice-bear__eyes {
		transform-origin: 100px 78px;
		animation: ice-bear-blink 5.2s ease-in-out infinite;
	}

	.ice-bear__steam {
		animation: ice-bear-steam 2.6s ease-in-out infinite;
	}

	.ice-bear__spark {
		transform-origin: 28px 102px;
		animation: ice-bear-spark 2.4s ease-in-out infinite;
	}

	@keyframes ice-bear-bob {
		0%,
		100% {
			transform: translateY(0) rotate(-1.4deg);
		}
		50% {
			transform: translateY(-7px) rotate(1.4deg);
		}
	}

	@keyframes ice-bear-shadow {
		0%,
		100% {
			transform: scaleX(1);
			opacity: 0.72;
		}
		50% {
			transform: scaleX(0.86);
			opacity: 0.45;
		}
	}

	@keyframes ice-bear-blink {
		0%,
		42%,
		48%,
		100% {
			transform: scaleY(1);
		}
		45% {
			transform: scaleY(0.08);
		}
	}

	@keyframes ice-bear-steam {
		0%,
		100% {
			opacity: 0.25;
			transform: translateY(0);
		}
		50% {
			opacity: 0.9;
			transform: translateY(-8px);
		}
	}

	@keyframes ice-bear-spark {
		0%,
		100% {
			opacity: 0.35;
			transform: scale(0.82) rotate(0deg);
		}
		50% {
			opacity: 1;
			transform: scale(1.08) rotate(18deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ice-bear__figure,
		.ice-bear__shadow,
		.ice-bear__eyes,
		.ice-bear__steam,
		.ice-bear__spark {
			animation: none;
		}
	}
</style>
